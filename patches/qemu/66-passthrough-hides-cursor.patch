+static void dpy_mouse_publish(QemuConsole *c);
+
+/*
+ * 2ksbox: while another card has the monitor (a Voodoo 2 through its
+ * pass-through cable, or the 3D frontend showing swaps), the display
+ * adapter's hardware cursor is not on the screen: a real pass-through
+ * cable shows the 3D card's picture and nothing of the 2D card's. The
+ * adapter's own cursor state is kept and published again when the monitor
+ * comes back. Before this, Windows' desktop pointer -- still enabled on the
+ * 2D adapter behind a full-screen Glide game -- was drawn over the game,
+ * beside the game's own pointer (Moto Racer on the Voodoo 2, 2026-09-17).
+ */
 void graphic_hw_passthrough(QemuConsole *con, bool passthrough)
 {
+    bool was = con->ui_info.passthrough;
+
     con->ui_info.passthrough = passthrough;
+    if (was != passthrough && QEMU_IS_GRAPHIC_CONSOLE(con)) {
+        dpy_mouse_publish(con);
+    }
 }
 
 void graphic_hw_update_done(QemuConsole *con)
@@ -687,7 +704,8 @@
