+/* the stored cursor to the listeners, hidden while in pass-through */
+static void dpy_mouse_publish(QemuConsole *c)
+{
+    QemuGraphicConsole *con = QEMU_GRAPHIC_CONSOLE(c);
+    DisplayState *s = c->ds;
+    DisplayChangeListener *dcl;
+    bool on = con->cursor_on && !c->ui_info.passthrough;
+
+    trace_dpy_mouse_publish(con->cursor_x, con->cursor_y, on, c->ui_info.passthrough);
+    if (!s || !qemu_console_is_visible(c)) {
         return;
     }
