+// 2ksbox (patch 05-lfb-locked-swap): what grLfbUnlock did for a write
+// lock, callable from grBufferSwap too. A Glide 2 title may hold the write
+// lock for the life of the program and treat the LFB as its frame buffer —
+// Carmageddon's 3dfx build does, for its whole front end — and upstream
+// drew the buffer only here, on an unlock that never comes: black frames,
+// one "LFB locked on buffer swap" in the QEMU log. The pixels are consumed
+// (reset to BLUE_SCREEN) exactly as before, so a swap uploads only what
+// changed since the last one; the lock itself is kept unless `release`.
+void LfbFlushWriteBuffer( bool release )
+{
     {
         if ( ! Glide.DstBuffer.Lock )
         {
-            return FXFALSE;
+            return;
         }
 
         FxU32 ii,
@@ -248,8 +250,28 @@ grLfbUnlock( GrLock_t dwType, GrBuffer_t dwBuffer )
             }
         }
 
-        Glide.DstBuffer.Lock = false;
+        if ( release )
+        {
+            Glide.DstBuffer.Lock = false;
+        }
+    }
+}
+
+//*************************************************
