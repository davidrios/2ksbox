/*
 * The display driver's resources. GDI and USER read the machine metrics,
 * the Control Panel's colour table and the three system fonts out of
 * `oembin` resources inside the .drv, and reject a driver without them
 * (doc 19 §11). The names and ordinals date back to Windows 2.x and cannot
 * change.
 *
 * SPDX-License-Identifier: GPL-2.0-or-later
 */
1     oembin  PRELOAD  config.bin
2     oembin           colortab.bin
3     oembin  PRELOAD  fonts.bin
fonts oembin           fonts.bin
2003  oembin  PRELOAD  fonts120.bin
