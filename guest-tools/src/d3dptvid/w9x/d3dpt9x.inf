; d3dpt9x.inf - the 2ksbox d3dpt-vga display driver for Windows 98/Me
; (doc 19, ADR-012 / M10). The XP driver's INF is d3dptvid.inf. On 9x the
; mode list lives in the registry, written from here rather than
; enumerated from the device (doc 19 §6).
;
; SPDX-License-Identifier: GPL-2.0-or-later

[version]
DriverVer=09/06/2026,1.0.0.0
Class=DISPLAY
signature="$CHICAGO$"
Provider=%Mfg%

[DestinationDirs]
DefaultDestDir=11            ; LDID_SYS
D3dpt.Copy=11

[SourceDisksNames]
1="2ksbox guest tools",,0

[SourceDisksFiles]
d3dpt9x.drv=1
d3dpt9v.vxd=1
d3dpt9hl.dll=1

[Manufacturer]
%Mfg%=Mfg.2ksbox

[Mfg.2ksbox]
%D3dpt.DeviceDesc%=D3dpt, PCI\VEN_1234&DEV_3D00

[D3dpt]
CopyFiles=D3dpt.Copy
DelReg=D3dpt.DelReg
AddReg=D3dpt.AddReg,Modes.AddReg

[D3dpt.Copy]
d3dpt9x.drv,,,0x00000004
d3dpt9v.vxd,,,0x00000004
; the ring-3 DirectDraw / Direct3D HAL: DirectDraw loads it into the
; game's own process, named by the .drv rather than by any registry key
d3dpt9hl.dll,,,0x00000004

; Clear the old keys before writing the new ones. An adapter that ran on
; the inbox VGA already has a `CURRENT` key naming that driver and a
; `MODES` tree of its modes. AddReg does not remove what it does not
; mention, so the leftovers would decide which driver GDI loads. The
; reference driver deletes these five too (doc 19 §16).
[D3dpt.DelReg]
HKR,,Ver
HKR,,DevLoader
HKR,DEFAULT
HKR,MODES
HKR,CURRENT

[D3dpt.AddReg]
HKR,,Ver,,4.0
HKR,,DevLoader,,*vdd
HKR,DEFAULT,drv,,d3dpt9x.drv
HKR,DEFAULT,vdd,,"*vdd"
HKR,DEFAULT,minivdd,,d3dpt9v.vxd
HKR,DEFAULT,RefreshRate,,-1
HKR,DEFAULT,ExtModeSwitch,,0
HKR,DEFAULT,DDC,,1
HKR,DEFAULT,Mode,,"32,640,480"

; The mini-VDD claims the adapter's PCI resources. Without it Windows
; takes the base addresses away and the display driver has nothing to
; map (doc 19 §11).

; The mode list. The driver runs 8, 16 and 32 bpp only, so the two 4 bpp
; rows hand the era's low-colour modes back to the inbox drivers by name.
; A 9x display INF is expected to do this, and it keeps a machine that is
; in one of those modes able to boot.
[Modes.AddReg]
HKR,"MODES\4\640,480",drv,,vga.drv
HKR,"MODES\4\640,480",vdd,,*vdd
HKR,"MODES\4\800,600",drv,,supervga.drv
HKR,"MODES\4\800,600",vdd,,*vdd
HKR,"MODES\8\640,480"
HKR,"MODES\8\800,600"
HKR,"MODES\8\1024,768"
HKR,"MODES\8\1280,1024"
HKR,"MODES\16\640,480"
HKR,"MODES\16\800,600"
HKR,"MODES\16\1024,768"
HKR,"MODES\16\1280,1024"
HKR,"MODES\32\640,480"
HKR,"MODES\32\800,600"
HKR,"MODES\32\1024,768"
HKR,"MODES\32\1280,1024"

[Strings]
Mfg="2ksbox"
D3dpt.DeviceDesc="2ksbox d3dpt-vga display adapter"
